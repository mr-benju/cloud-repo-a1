# Configuración de la Base de Datos (PostgreSQL)
POSTGRES_DB=incidencias_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Configuración del Backend (Spring Boot)
BACKEND_PORT=8080
